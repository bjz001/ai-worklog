MYSQL_HOST=mysql.example.internal
MYSQL_PORT=3306
MYSQL_USER=ai_worklog_app
MYSQL_PASSWORD=replace-with-a-secret
MYSQL_DATABASE=ai_worklog
MYSQL_SSL=true
# 仅当 MySQL 位于可信私网/加密隧道且暂无 TLS 时才显式改为 true。
ALLOW_INSECURE_MYSQL=false
MYSQL_CONNECTION_LIMIT=10
MYSQL_QUEUE_LIMIT=100

APP_BASE_URL=http://localhost:3000
APP_ACCOUNT_ID=account_demo
APP_TIME_ZONE=Asia/Shanghai
# 生成 32 字节随机值并以 64 位十六进制保存；更换前必须先迁移已有 LLM 密文。
LLM_SETTINGS_ENCRYPTION_KEY=replace-with-64-hex-characters
DASHBOARD_USERNAME=owner
DASHBOARD_PASSWORD=replace-with-a-long-random-password
DEVICE_TOKEN_PEPPER=replace-with-at-least-32-random-characters
MACOS_DEVICE_ID=device_macos_demo
WINDOWS_DEVICE_ID=device_windows_demo
MACOS_DEVICE_TOKEN=replace-with-device-token
WINDOWS_DEVICE_TOKEN=replace-with-device-token

# 仅供 docker-compose.yml 的隔离测试数据库使用。
LOCAL_MYSQL_ROOT_PASSWORD=replace-with-a-local-test-password
