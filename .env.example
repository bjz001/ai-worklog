MYSQL_HOST=mysql.example.internal
MYSQL_PORT=3306
MYSQL_USER=ai_worklog_app
MYSQL_PASSWORD=replace-with-a-secret
MYSQL_DATABASE=ai_worklog
MYSQL_SSL=false

APP_BASE_URL=http://localhost:3000
APP_ACCOUNT_ID=account_demo
APP_TIME_ZONE=Asia/Shanghai
DEVICE_TOKEN_PEPPER=replace-with-at-least-32-random-characters
MACOS_DEVICE_TOKEN=replace-with-device-token
WINDOWS_DEVICE_TOKEN=replace-with-device-token

# 仅供 docker-compose.yml 的隔离测试数据库使用。
LOCAL_MYSQL_ROOT_PASSWORD=replace-with-a-local-test-password
