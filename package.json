{
  "name": "ai-worklog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ai-worklog/web",
    "build": "npm run build -w @ai-worklog/web",
    "start:lan": "next start apps/web --hostname 172.18.209.21 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:bootstrap": "tsx packages/db/src/bootstrap.ts",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:seed": "tsx packages/db/src/seed.ts",
    "llm:key:init": "node scripts/ensure-llm-encryption-key.mjs",
    "lan:http:configure": "node scripts/lan-http/configure.mjs",
    "collector:configure:macos": "node scripts/configure-macos-collector.mjs",
    "collector": "tsx apps/collector/src/index.ts",
    "worker": "tsx apps/worker/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.20",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "tsx": "^4.23.1"
  }
}
