# Copy this file OUTSIDE the repository, then replace every placeholder.
# macOS default:  ~/.config/ai-worklog/collector.env
# Windows default: %LOCALAPPDATA%\AIWorklog\collector.env
#
# Each machine must use its own AI_WORKLOG_DEVICE_ID and device token.
# Keep AI_WORKLOG_ACCOUNT_ID and AI_WORKLOG_SYNC_URL identical to merge both
# machines into the same account. Codex and Claude Code are both required on
# each machine and must use distinct source instance IDs and source paths.
# Values are parsed as data, never as shell code.

AI_WORKLOG_ACCOUNT_ID=replace-with-account-id
AI_WORKLOG_DEVICE_ID=replace-with-this-machine-device-id
CODEX_SOURCE_INSTANCE_ID=replace-with-this-machine-codex-instance-id
CODEX_SOURCE_PATH=replace-with-absolute-codex-jsonl-path
CLAUDE_CODE_SOURCE_INSTANCE_ID=replace-with-this-machine-claude-code-instance-id
CLAUDE_CODE_SOURCE_PATH=replace-with-absolute-claude-code-jsonl-path
AI_WORKLOG_PATH_HMAC_KEY=replace-with-a-long-random-path-key
COLLECTOR_DB_PATH=replace-with-absolute-local-sqlite-path
AI_WORKLOG_SYNC_URL=https://replace-with-server/api/v1/sync/batches
AI_WORKLOG_ALLOW_INSECURE_LAN_HTTP=false
AI_WORKLOG_DEVICE_TOKEN=replace-with-this-machine-device-token

# Optional but recommended for launchd/Task Scheduler, whose PATH is minimal.
# macOS example: /opt/homebrew/bin/node
# Windows example: C:\Program Files\nodejs\node.exe
NODE_BINARY=replace-with-absolute-node-binary-path
